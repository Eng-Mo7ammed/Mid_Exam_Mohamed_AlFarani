<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5ED"
    tools:context=".MainActivity">

    <!-- Artwork Counter -->
    <TextView
        android:id="@+id/artworkCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:text="1 / 6"
        android:textSize="18sp"
        android:textColor="#29211C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Artwork White Frame -->
    <LinearLayout
        android:id="@+id/artworkCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/artworkCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/artworkImage"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:background="#292929"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Artwork image" />

    </LinearLayout>

    <!-- Artwork Information -->
    <LinearLayout
        android:id="@+id/artworkInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="18dp"
        android:background="#FFEADE"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/artworkCard"
        app:layout_constraintBottom_toTopOf="@id/navigationButtons"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/artworkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deep Field Stellar Deaths"
            android:textColor="#211B17"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/artworkArtistYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Smacs Carin (2021)"
            android:textColor="#29211C"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Previous and Next Buttons -->
    <LinearLayout
        android:id="@+id/navigationButtons"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/previousButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="7dp"
            android:text="Previous"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            android:textColor="@color/artspace_button_text"
            app:backgroundTint="@color/artspace_button_tint"
            app:cornerRadius="30dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="Next"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/artspace_button_text"
            app:backgroundTint="@color/artspace_button_tint"
            app:cornerRadius="30dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
