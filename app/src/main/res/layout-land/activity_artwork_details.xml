
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5ED"
    android:fillViewport="true"
    tools:context=".ArtworkDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Screen Title -->
        <TextView
            android:id="@+id/detailsPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artwork Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#29211C"
            android:gravity="center" />

        <!-- Details Card -->
        <LinearLayout
            android:id="@+id/detailsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Artwork"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#914B1B" />

            <TextView
                android:id="@+id/artworkDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Artwork information"
                android:textSize="17sp"
                android:textColor="#29211C" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Back to Gallery"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#29211C"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#E6DDD7"
                app:cornerRadius="25dp" />

            <Button
                android:id="@+id/visitWebsiteButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Visit Website"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="#914B1B"
                app:cornerRadius="25dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
